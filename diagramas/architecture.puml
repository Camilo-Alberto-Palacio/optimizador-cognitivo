@startuml Architecture_v9
skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
title Arquitectura del Sistema - Quantum Biohacking Engine v9.0 Final

package "Capa de UI (React + Tailwind)" #EEF2FF {
  [App.tsx] as App <<Orchestrator>>
  [JournalTimeline.tsx] as Journal <<Historial + Fechas>>
  [SupplementSelector.tsx] as Selector <<Favoritos + Registro>>
  [FitnessPanel.tsx] as Fitness <<SpO2 XL + Stress UI + Health Bento>>
  [MasterChart.tsx] as Chart <<Recharts v2>>
  [AnalyticsDashboard.tsx] as Analytics <<7-Day Trends>>
  [BibliographyView.tsx] as Biblio <<Evidencia APA 7>>
  [HeaderStats.tsx] as Stats <<CI Dinámico>>
  [LoginScreen.tsx] as Login
  [Profile/Accessibility] as Profile <<Tú + Guía + Inclusión>>
}

package "Capa de Estado (Zustand v5)" #F0FDF4 {
  [useEngineStore] as Store <<Persist + Accessibility State + Cloud Sync>>
}

package "Motor de Lógica (Quantum Engine)" #FFF7ED {
  [calculator.ts] as CalcEngine <<Farmacocinética Multi-Variable + CI Logic>>
  [googleFit.ts] as FitService <<Biometría Triple Sincronizada>>
  [supplements.ts] as Catalog <<Base de Datos Nootrópicos/Alimentos>>
}

package "Servicios Cloud" #F0F4FF {
  [Google Fit API] as FitAPI <<OAuth2>>
  [Firebase Firestore] as DB <<Persistencia Realtime>>
  [Firebase Auth] as Auth <<Social Login>>
}

' UI a Zustand/Servicios
App --> Journal
App --> Selector
App --> Fitness
App --> Chart
App --> Analytics
App --> Biblio : "vía Profile menu"
App --> Login : "si !user"
App --> Profile

Store ..> Journal : "allLogs"
Store ..> Selector : "favorites"
Store ..> Fitness : "spo2/stress manual"
Store ..> Chart : "iqDataPoints"
Store ..> Profile : "hasSeenTutorial / config"

' Sincronización
Store -down-> CalcEngine : "Data Stream"
Store -down-> FitService : "Sync Request"
FitService -right-> FitAPI : "REST"
DB <-left-> Store : "Firestore Sync"
Auth --> Store : "JWT / Profile"

@enduml
