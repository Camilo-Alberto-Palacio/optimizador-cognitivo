@startuml Architecture_v2
skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
title Arquitectura del Sistema - Optimizador Cognitivo v8.0 Enterprise

package "Capa de UI (React Components)" #EEF2FF {
  [App.tsx] as App <<Orchestrator>>
  [JournalTimeline.tsx] as Journal <<Historial + Fechas>>
  [SupplementSelector.tsx] as Selector <<Favoritos + Registro>>
  [FitnessPanel.tsx] as Fitness <<Salud + Ajustes>>
  [MasterChart.tsx] as Chart <<Recharts>>
  [HeaderStats.tsx] as Stats
  [WarningAlerts.tsx] as Alerts <<Medical Panel>>
  [LoginScreen.tsx] as Login
  [IqAssessment/] as IQ <<Test Cognitivo>>
}

package "Capa de Estado (Zustand v5)" #F0FDF4 {
  [useEngineStore] as Store <<Persist + Cloud Sync>>
}

package "Motor de Lógica (Domain Engine)" #FFF7ED {
  [calculator.ts] as CalcEngine <<Farmacocinética + CI Breakdown>>
  [googleFit.ts] as FitService <<Triple Verificación>>
  [supplements.ts] as Catalog <<~100 entradas>>
}

package "Servicios de Plataforma" #F0F4FF {
  [Google Fit API] as FitAPI <<OAuth Restricted>>
  [Firebase Auth/DB] as Cloud <<Cloud Sync>>
  [Vite PWA] as PWA <<Offline Support>>
}

' UI a Zustand/Servicios
App --> Journal
App --> Selector
App --> Fitness
App --> Chart
App --> Stats
App --> Login : "si !user"
App --> IQ : "si !assessmentCompleted"

Store ..> Journal : "allLogs[date]"
Store ..> Selector : "favorites"
Store ..> Fitness : "fitnessData\nmanualSleepAdjustment"
Store ..> Chart : "chartData[iqBase/Fit/Boost]"
Store ..> Stats : "baseIq\nselectedDate"

Journal ..> Store : "setSelectedDate()\ntoggleLogVisibility()"
Selector ..> Store : "addLog()\ntoggleFavorite()"
Fitness ..> Store : "loadFitnessData()\nupdateManualSleep()"

' Zustand a Motor
Store -down-> CalcEngine : "logs[], baseIq, fitness"
CalcEngine -up-> Store : "ChartDataPoint[]"
Store -down-> FitService : "fetchFitnessData(token)"
FitService -up-> Store : "FitnessData"
FitService -right-> FitAPI : "REST POST/JSON"

' Servicios
Cloud --> Store : "Auth + Firestore Sync"
PWA --> App : "Offline Cache"

@enduml
