@startuml UseCases_v2
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FAFAFA
title Casos de Uso - Optimizador Cognitivo v8.0 Enterprise

actor "Usuario" as User
actor "Motor" as Engine
actor "Google Fit" as FitAPI

rectangle "Optimizador Cognitivo" {

  package "Bio-Sincronización" {
    usecase "Vincular Cuenta Google Fit" as UC_FitLink
    usecase "Sincronizar Sueño/Pasos/FC" as UC_FitSync
    usecase "Ajustar Sueño Manualmente" as UC_SleepAdj
  }

  package "Bitácora Inteligente" {
    usecase "Registrar Suplemento" as UC_Log
    usecase "Navegar Historial (Fechas)" as UC_Nav
    usecase "Ocultar Evento (Simular Desactivación)" as UC_Hide
    usecase "Gestionar Favoritos" as UC_Fav
  }

  package "Análisis y Visualización" {
    usecase "Ver Gráfico de Rendimiento" as UC_Chart
    usecase "Consultar Tendencias Semanales" as UC_Trends
    usecase "Consultar Desglose de CI" as UC_CI_Breakdown
    usecase "Recibir Alertas de Interacción" as UC_Alerts
  }
}

User --> UC_FitLink
User --> UC_FitSync
User --> UC_SleepAdj
User --> UC_Log
User --> UC_Nav
User --> UC_Hide
User --> UC_Fav
User --> UC_Chart
User --> UC_CI_Breakdown

UC_FitSync <--- FitAPI : "Provee bio-datos"
UC_Log --> Engine : "Calcula impacto"
UC_Hide --> Engine : "Recalcula sin impacto"
UC_SleepAdj --> Engine : "Ajusta base CI"

Engine --> UC_Chart
Engine --> UC_CI_Breakdown
Engine --> UC_Alerts

@enduml
