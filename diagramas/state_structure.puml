@startuml StateStructure_v2
skinparam class {
    BackgroundColor White
    ArrowColor #6366f1
    BorderColor #1e293b
    FontSize 12
}
skinparam backgroundColor #FAFAFA
title Estructura del Estado Global - useEngineStore (Zustand v5)

class "useEngineStore" as Store {
    + allLogs: Record<DateStr, LogEvent[]>
    + selectedDate: string
    + favorites: string[]
    + chartData: ChartDataPoint[]
    + fitnessData: FitnessData | null
    + isFetchingFitness: boolean
    + activeView: 'dashboard' | 'analytics'
    + manualSleepAdjustment: Record<string, number>
    + fitAccessToken: string | null
    + baseIq: number | null
    + hasCompletedAssessment: boolean
    + user: User | null
    --
    + setSelectedDate(date: string)
    + setActiveView(view: string)
    + addLog(suppId, time, qty?, note?)
    + toggleLogVisibility(id: string)
    + updateManualSleep(hours: number)
    + loadFitnessData()
    + loadWeeklyFitnessData()
    + setFitToken(token: string)
    - recalculate()
}

class "LogEvent" as Event {
    + id: string (UUID)
    + supplementId: string
    + timeStr: string (HH:mm)
    + quantity: number
    + note?: string
    + hidden: boolean
}

class "FitnessData" as Fit {
    + sleepHours: number | null
    + restingHeartRate: number | null
    + steps: number | null
    + activeCalories: number | null
    + lastFetched: number
}

class "ChartDataPoint" as Chart {
    + time: string (HH:mm)
    + iq: number (Real/Total)
    + iqBase: number (Sin ajustes)
    + iqFitness: number (Impacto Fit)
    + iqBoost: number (Impacto Logs)
    + flow: boolean
}

class "SupplementDef" as Supp {
    + id: string
    + name: string
    + effectK: number
    + durationH: number
    + category: Category
}

Store *-- Event : allLogs{date: Event[]}
Store *-- Fit : fitnessData
Store *-- Chart : chartData[]
Event --> Supp : supplementId (ref)

note bottom of Store
  Persistencia:
  - Firestore: manualSleepAdjustment, allLogs, favorites
  - LocalStorage: fitAccessToken, baseIq, config
end note

@enduml
