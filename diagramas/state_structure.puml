@startuml StateStructure_v2
skinparam class {
    BackgroundColor White
    ArrowColor #6366f1
    BorderColor #1e293b
    FontSize 12
}
skinparam backgroundColor #FAFAFA
title Estructura del Estado Global - useEngineStore (Zustand v5)

class "useEngineStore" as Store {
    + allLogs: Record<DateStr, LogEvent[]>
    + selectedDate: string
    + favorites: string[]
    + chartData: ChartDataPoint[]
    + warnings: Warning[]
    + baseIq: number | null
    + hasCompletedAssessment: boolean
    + user: User | null
    + authLoading: boolean
    --
    + setSelectedDate(date: string)
    + addLog(suppId, time, qty?, note?)
    + removeLog(id: string)
    + toggleFavorite(suppId: string)
    + setBaseIq(iq: number)
    + resetAssessment()
    + setUser(user: User | null)
    - recalculate()
    + getLogsForDate(date: string)
}

class "LogEvent" as Event {
    + id: string (UUID)
    + supplementId: string
    + date: string (YYYY-MM-DD)
    + timeStr: string (HH:mm)
    + quantity: number
    + timestamp: number
    + note?: string
}

class "SupplementDef" as Supp {
    + id: string
    + name: string
    + category: SupplementCategory
    + effectK: number
    + durationH: number
    + isStimulant?: boolean
    + toxicityScore?: number
    + interactionTags?: string[]
    + macronutrients?: MacroProfile
}

class "MacroProfile" as Macro {
    + protein: number
    + carbs: number
    + fats: number
    + calories: number
}

class "ChartDataPoint" as Chart {
    + time: string (HH:mm)
    + natural: number (0-100)
    + optimized: number (0-100)
    + iq: number
    + flow: boolean
}

class "Warning" as Warn {
    + id: string
    + type: 'interaction' | 'toxicity'\n   | 'dietary' | 'general'
    + severity: 'high' | 'medium' | 'low'
    + message: string
    + suggestion?: string
}

enum "SupplementCategory" as Cat {
    nootropic
    mineral
    stimulant
    nutrition
    adaptation
    other
}

Store *-- Event : allLogs{date: Event[]}
Store *-- Chart : chartData[]
Store *-- Warn : warnings[]
Supp --> Cat : category
Supp *-- Macro : macronutrients?
Event --> Supp : supplementId (ref)

note bottom of Store
  Persistencia dual:
  - LocalStorage (Zustand persist)
  - Firestore (cloud sync por usuario)
  Clave: 'quantum-engine-storage-v2'
end note

@enduml
